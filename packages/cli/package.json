{
  "name": "panelui-cli",
  "version": "0.7.0",
  "description": "Add PanelUI components to an Expo project one at a time, source and all.",
  "type": "module",
  "bin": {
    "panelui-cli": "bin/panelui.mjs"
  },
  "//exports": "Subpaths, so create-panelui-app can call the scaffolder directly instead of re-launching this CLI through npx. Anything not listed here is private.",
  "exports": {
    "./init": "./src/init.mjs",
    "./ui": "./src/ui.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "react-native",
    "expo",
    "ui",
    "cli",
    "registry",
    "components"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panel-ui/PanelUI.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/panel-ui/PanelUI/issues"
  },
  "author": "Khalid Abdi",
  "license": "MIT",
  "homepage": "https://panelui.dev/docs/cli"
}
